{
  "name": "briefpilot-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "observability:prune": "node scripts/prune-ai-usage.mjs",
    "observability:report": "node scripts/ai-usage-report.mjs",
    "test:pdf-worker": "node --test tests/pdf-worker.integration.test.mjs",
    "test:pdf-worker:docker": "node scripts/test-pdf-worker-docker.mjs",
    "db:staging:check": "node scripts/staging-database.mjs check",
    "db:staging:status": "node scripts/staging-database.mjs status",
    "db:staging:deploy": "node scripts/staging-database.mjs deploy",
    "db:staging:seed": "node scripts/staging-database.mjs seed",
    "staging:preflight": "node scripts/staging-preflight.mjs",
    "db:staging:prisma-check": "NEON_READONLY_CHECK=1 vitest run src/server/database/__tests__/neon.readonly.test.ts",
    "pdf:worker:prepare-vercel": "node scripts/prepare-pdf-worker-vercel.mjs",
    "test:pdf-worker:vercel-artifact": "node scripts/test-pdf-worker-docker.mjs --vercel-artifact"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.14.0",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "openai": "^7.39.0",
    "pg": "^8.21.0",
    "pino": "^10.4.0",
    "playwright": "^1.64.1",
    "posthog-js": "^1.438.12",
    "posthog-node": "^5.56.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "^7.10.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.9 <12"
  },
  "packageManager": "pnpm@11.9.0"
}
