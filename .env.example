# Copy to .env and set values locally. Never commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/briefpilot_ai?schema=public"
# Required only when starting PostgreSQL with Docker Compose. Match DATABASE_URL.
COMPOSE_POSTGRES_PASSWORD=""
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
OPENAI_API_KEY=""
# Set a model available to your API project and supporting Structured Outputs.
OPENAI_MODEL=""

# Lemon Squeezy: test mode only. Obtain all IDs and secrets from your own store.
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_PRO_VARIANT_ID=""
LEMONSQUEEZY_AGENCY_VARIANT_ID=""
LEMONSQUEEZY_TEST_MODE="true"

# Optional preinstalled Chromium; keep the sandbox enabled and run as non-root.
PDF_CHROMIUM_EXECUTABLE_PATH=""

# Observability: opt in per environment. Test runners force remote delivery off.
OBSERVABILITY_ENABLED="false"
OBSERVABILITY_ENVIRONMENT="development"
OBSERVABILITY_TEST_MODE="false"
LOG_LEVEL="info"
AI_MONITORING_ENABLED="false"
AI_USAGE_RETENTION_DAYS="90"

# Sentry sends sanitized errors only; tracing, replay and profiling remain off.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_OBSERVABILITY_ENABLED="false"
NEXT_PUBLIC_OBSERVABILITY_ENVIRONMENT="development"
NEXT_PUBLIC_OBSERVABILITY_TEST_MODE="false"
# Optional CI source-map credentials, never NEXT_PUBLIC. No upload configured by default.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Server-side product analytics only, subject to the user's saved consent.
POSTHOG_ENABLED="false"
POSTHOG_PROJECT_TOKEN=""
POSTHOG_HOST="https://eu.i.posthog.com"
# Generate a separate random secret of at least 32 characters per environment.
ANALYTICS_HMAC_SECRET=""

# Runtime environment: development | staging | production (independent of NODE_ENV).
APP_ENV="development"
# Optional direct connection for Prisma CLI. Local development falls back to DATABASE_URL.
DIRECT_URL=""
# Max connections per warm process; 1..20, default 5.
DATABASE_POOL_MAX="5"
# PDF: local in development; worker mandatory on Vercel. No automatic local fallback.
PDF_RENDER_MODE="local"
PDF_WORKER_URL=""
PDF_WORKER_SECRET=""
# Optional server-only automation token scoped to the Vercel worker project.
PDF_WORKER_VERCEL_BYPASS_SECRET=""
