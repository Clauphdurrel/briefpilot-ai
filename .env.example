# Copy to .env and set values locally. Never commit real secrets.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/briefpilot_ai?schema=public"
# Required only when starting PostgreSQL with Docker Compose. Match DATABASE_URL.
COMPOSE_POSTGRES_PASSWORD=""
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
OPENAI_API_KEY=""
# Set a model available to your API project and supporting Structured Outputs.
OPENAI_MODEL=""

# Lemon Squeezy: test mode only. Obtain all IDs and secrets from your own store.
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_PRO_VARIANT_ID=""
LEMONSQUEEZY_AGENCY_VARIANT_ID=""
LEMONSQUEEZY_TEST_MODE="true"

# Optional preinstalled Chromium; keep the sandbox enabled and run as non-root.
PDF_CHROMIUM_EXECUTABLE_PATH=""
