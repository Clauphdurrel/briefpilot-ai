// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectType {
  WEBSITE
  ECOMMERCE
  SAAS
  MOBILE_APP
  INTERNAL_TOOL
  AUTOMATION
  OTHER
}

enum ProjectStatus {
  DRAFT
  INTERVIEW
  BRIEF_GENERATED
  VALIDATED
  ARCHIVED
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  emailVerified DateTime?
  image         String?
  analyticsConsent Boolean @default(false)

  accounts Account[]
  sessions Session[]
  projects Project[]
  subscription Subscription?
  usageCounters UsageCounter[]
  usageEvents UsageEvent[]
  billingCheckouts BillingCheckoutIntent[]
  aiUsageLogs AIUsageLog[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  type        ProjectType
  description String?
  status      ProjectStatus @default(DRAFT)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  interviews InterviewMessage[]
  briefs     Brief[]
  backlogs   Backlog[]
  backlogGenerations BacklogGeneration[]
  aiUsageLogs AIUsageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([type])
  @@index([status])
}

model InterviewMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  metadata  Json?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
}

model Brief {
  id      String @id @default(cuid())
  title   String
  content String
  json    Json?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  backlogs Backlog[]

  @@index([projectId])
  @@unique([id, projectId])
}

enum BacklogStatus {
  DRAFT
  READY
}

model Backlog {
  id            String @id @default(cuid())
  projectId     String
  sourceBriefId String
  version       Int
  status        BacklogStatus
  data          Json
  sourceRevision String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceBrief   Brief @relation(fields: [sourceBriefId, projectId], references: [id, projectId], onDelete: Cascade)
  generations   BacklogGeneration[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId, version])
  @@index([sourceBriefId])
  @@index([projectId, sourceRevision])
}

// Durable idempotency, leases and actual attempt timestamps, including failed calls.
model BacklogGeneration {
  id            String @id @default(cuid())
  projectId     String
  requestId     String
  payloadHash   String
  sourceRevision String
  state         String
  chargedAt     DateTime[] @default([])
  lastAttemptAt DateTime?
  leaseUntil    DateTime?
  backlogId     String?
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  backlog       Backlog? @relation(fields: [backlogId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId, requestId])
  @@index([projectId, lastAttemptAt])
}

enum SubscriptionPlan {
  FREE
  PRO
  AGENCY
  ENTERPRISE
}
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}
enum SubscriptionProvider {
  NONE
  STRIPE
  LEMONSQUEEZY
}
enum UsageResource {
  AI_INTERVIEW
  AI_BRIEF
  AI_BACKLOG
  PDF_EXPORT
  ACTIVE_PROJECTS
}
enum UsageStatus {
  RESERVED
  STARTED
  COMMITTED
  RELEASED
}
model Subscription {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @default(FREE)
  status SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd DateTime
  provider SubscriptionProvider @default(NONE)
  providerCustomerId String?
  providerSubscriptionId String? @unique
  providerVariantId String?
  providerRevision String?
  providerCreatedAt DateTime?
  providerTestMode Boolean @default(false)
  cancelAtPeriodEnd Boolean @default(false)
  accessEndsAt DateTime?
  limitOverrides Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model UsageCounter {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource UsageResource
  periodStart DateTime
  periodEnd DateTime
  used Int @default(0)
  reserved Int @default(0)
  events UsageEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, resource, periodStart, periodEnd])
}
model UsageEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource UsageResource
  operationId String
  status UsageStatus @default(RESERVED)
  units Int @default(1)
  counterId String
  counter UsageCounter @relation(fields: [counterId], references: [id], onDelete: Cascade)
  leaseUntil DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, resource, operationId])
  @@index([userId, status, leaseUntil])
}

model BillingCheckoutIntent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan
  tokenHash String
  providerCheckoutId String? @unique
  providerSubscriptionId String? @unique
  url String?
  state String @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, expiresAt])
}
model BillingWebhookEvent {
  id String @id
  eventName String
  providerSubscriptionId String
  outcome String
  createdAt DateTime @default(now())
  @@index([providerSubscriptionId, createdAt])
}

// Technical telemetry only: no prompt, response, error message, email or credential.
model AIUsageLog {
  id String @id @default(cuid())
  attemptId String @unique
  requestId String?
  operationId String?
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agent String
  model String
  durationMs Int
  inputTokens Int?
  cachedInputTokens Int?
  outputTokens Int?
  totalTokens Int?
  estimatedCost Decimal? @db.Decimal(20, 12)
  currency String @default("USD")
  pricingVersion String?
  status String
  errorCode String?
  usageStatus String
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([operationId])
}
